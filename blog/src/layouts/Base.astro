---
/* Import global styles so Astro bundles them */
import "../styles.css";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}
const { title = "Evalyard Blog", description = "On-device LLM benchmarking, distributed inference, mobile AI.", canonical } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" />
    <!-- Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot name="header" />
    <main class="container">
      <slot />
    </main>
    <footer class="footer">
      <div class="container small">© {new Date().getFullYear()} Evalyard · <a href="/rss.xml">RSS</a></div>
    </footer>
  </body>
</html>
