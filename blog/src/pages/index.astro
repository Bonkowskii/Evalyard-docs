---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";

const posts = (await getCollection("blog"))
  .sort((a, b) => (b.data.pubDate?.getTime() || 0) - (a.data.pubDate?.getTime() || 0));
---
<Base title="Evalyard Blog" description="Updates from the Evalyard team: LLM benchmarking, distributed inference, and on-device AI.">
  <Header slot="header" />
  <div class="hero">
    <h1>Evalyard Blog</h1>
    <p>On-device LLM benchmarking, distributed inference, mobile AI.</p>
  </div>

  <section class="list">
    {posts.length === 0 ? (
      <div class="card"><div class="meta">No posts yet. Add Markdown files to <code>src/content/blog/</code>.</div></div>
    ) : (
      posts.map((p) => (
        <article class="card">
          <h2><a href={`/${p.slug}/`}>{p.data.title}</a></h2>
          <div class="meta">
            {p.data.pubDate && new Date(p.data.pubDate).toLocaleDateString()} · {p.data.tags?.join(", ")}
          </div>
          <p>{p.data.description}</p>
        </article>
      ))
    )}
  </section>
</Base>
