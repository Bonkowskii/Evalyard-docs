---
const posts = Object.values(import.meta.glob('./blog/*.mdx', { eager: true }));
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Evalyard Blog</title>
    <link rel="alternate" type="application/rss+xml" href="/blog/rss.xml" />
    <style>
      body{font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,Helvetica,Arial,sans-serif;padding:24px;max-width:860px;margin:0 auto}
      nav a{margin-right:12px;text-decoration:none;color:#374151}
      .post{padding:14px 0;border-bottom:1px solid #e5e7eb}
      .title{font-size:1.15rem;margin:0}
      .desc{color:#6b7280;margin:.25rem 0}
      .date{color:#9ca3af;font-size:.875rem}
      header{margin:10px 0 24px}
    </style>
  </head>
  <body>
    <nav>
      <a href="/">Home</a>
      <a href="/docs/">Docs</a>
      <a href="/blog/">Blog</a>
    </nav>
    <header>
      <h1>Evalyard Blog</h1>
      <p>On-device LLM benchmarking, distributed inference, mobile AI.</p>
    </header>

    {posts
      .sort((a, b) => new Date(b.frontmatter?.pubDate||0) - new Date(a.frontmatter?.pubDate||0))
      .map((p) => (
        <article class="post">
          <a href={p.url}><h2 class="title">{p.frontmatter?.title || p.url}</h2></a>
          {p.frontmatter?.description && <p class="desc">{p.frontmatter.description}</p>}
          {p.frontmatter?.pubDate && <div class="date">{new Date(p.frontmatter.pubDate).toDateString()}</div>}
        </article>
      ))
    }
  </body>
</html>
